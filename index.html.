-- ============================================
-- SOUKLY — Migration : comptes utilisateurs & profils
-- 100% additive : n'efface ni ne modifie aucune donnée existante.
-- À coller dans Supabase : SQL Editor > New query > Run
-- ============================================

-- Table des profils, liée aux comptes Supabase Auth
create table if not exists profiles (
  id uuid primary key references auth.users(id) on delete cascade,
  username text,
  city text,
  avatar_url text,
  created_at timestamptz default now()
);
alter table profiles enable row level security;
drop policy if exists "Lecture publique profils" on profiles;
create policy "Lecture publique profils" on profiles for select using (true);
drop policy if exists "Un utilisateur modifie son profil" on profiles;
create policy "Un utilisateur modifie son profil" on profiles for update using (auth.uid() = id);
drop policy if exists "Un utilisateur crée son profil" on profiles;
create policy "Un utilisateur crée son profil" on profiles for insert with check (auth.uid() = id);

-- Création automatique du profil à l'inscription
create or replace function public.handle_new_user()
returns trigger as $$
begin
  insert into public.profiles (id, username, city)
  values (
    new.id,
    coalesce(new.raw_user_meta_data->>'username', split_part(new.email,'@',1)),
    new.raw_user_meta_data->>'city'
  )
  on conflict (id) do nothing;
  return new;
end;
$$ language plpgsql security definer;

drop trigger if exists on_auth_user_created on auth.users;
create trigger on_auth_user_created
  after insert on auth.users
  for each row execute procedure public.handle_new_user();

-- Lien entre les annonces et les comptes (colonnes nullable : les annonces
-- déjà publiées sans compte restent intactes et visibles)
alter table listings add column if not exists user_id uuid references auth.users(id);
alter table listings add column if not exists sold boolean default false;

-- Avis vendeurs (étoiles)
create table if not exists reviews (
  id bigint generated always as identity primary key,
  seller_id uuid references auth.users(id) on delete cascade,
  reviewer_id uuid references auth.users(id) on delete cascade,
  reviewer_name text,
  rating int check (rating between 1 and 5),
  comment text,
  created_at timestamptz default now()
);
alter table reviews enable row level security;
drop policy if exists "Lecture publique avis" on reviews;
create policy "Lecture publique avis" on reviews for select using (true);
drop policy if exists "Ecriture avis pour utilisateur connecté" on reviews;
create policy "Ecriture avis pour utilisateur connecté" on reviews for insert with check (auth.uid() = reviewer_id);

